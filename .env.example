# Copia este archivo a .env.local y rellena los valores de tu proyecto
# (Supabase Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Opcional: clave publicable nueva (sb_publishable_...), equivalente a la anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave

# — Solo servidor (nunca con prefijo NEXT_PUBLIC_) —
# Supabase Dashboard → Project Settings → API → service_role. La usa el servidor para leer la conexión
# de Google Calendar al crear citas.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Google Calendar (Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth, tipo «Aplicación web»).
# URI de redirección autorizado: <tu dominio>/admin/google/callback (p. ej. http://localhost:3000/admin/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra el refresh token guardado en la base. Generar con: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
