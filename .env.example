# Copia este archivo a .env.local y rellena los valores de tu proyecto
# (Supabase Dashboard → Project Settings → API).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# Opcional: clave publicable nueva (sb_publishable_...), equivalente a la anon key.
# También se aceptan los nombres con prefijo NEXT_PUBLIC_.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave

# — Solo servidor (nunca con prefijo NEXT_PUBLIC_) —
# OBLIGATORIA. Supabase Dashboard → Project Settings → API → service_role. Solo el servidor crea citas
# (la anon key ya no puede insertar), aplica los límites anti-spam y lee la conexión de Google Calendar.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Google Calendar (Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth, tipo «Aplicación web»).
# URI de redirección autorizado: <tu dominio>/admin/google/callback (p. ej. http://localhost:3000/admin/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra el refresh token guardado en la base. Generar con: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Aviso por correo de cada cita nueva (https://resend.com → API Keys). Si falta alguna, no se envía.
RESEND_API_KEY=
# A dónde llega el aviso (tu Gmail).
NOTIFY_EMAIL=
# Remitente. Sin dominio verificado en Resend usa el de prueba (solo envía al correo de tu cuenta Resend).
# Con fero.ink verificado: FERO <citas@fero.ink>
NOTIFY_FROM=FERO <onboarding@resend.dev>

# Cloudflare Turnstile (anti-spam en «Confirmar cita»). Cloudflare Dashboard → Turnstile → Add widget.
# Para desarrollo puedes usar las claves de prueba de Cloudflare (siempre aprueban):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Sin claves: en desarrollo se omite la verificación; en producción se rechazan las reservas.
# Pública (el servidor la pasa al navegador en cada petición; también vale NEXT_PUBLIC_TURNSTILE_SITE_KEY).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL pública del sitio, sin "/" final (canonical, Open Graph, sitemap, robots y datos estructurados).
# Obligatoria al compilar en producción fuera de Vercel; en Vercel, si falta, se usa el dominio de producción.
SITE_URL=https://fero.ink
